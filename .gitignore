```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.class
*.o
*.exe
*.dll
*.so
*.a
*.obj
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/
*.min.js
*.min.css
bundle.js

# Editors and IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System files
.DS_Store
Thumbs.db

# Logs and cache
*.log
coverage/
htmlcov/
.coverage
.mypy_cache/
.pytest_cache/
.gradle/
```